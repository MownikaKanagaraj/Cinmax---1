{
  "name": "@cinmax/api",
  "version": "1.0.0",
  "private": true,
  "description": "Supabase client adapters, 12 domain API modules, and React Query orchestration for CINMAX Global Products",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client/browser": "./src/client/browser.ts",
    "./client/server": "./src/client/server.ts",
    "./client/mobile": "./src/client/mobile.ts",
    "./payments": "./src/payments/index.ts",
    "./modules/*": "./src/modules/*/index.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts*\"",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@cinmax/constants": "workspace:*",
    "@cinmax/types": "workspace:*",
    "@cinmax/utils": "workspace:*",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.66.0",
    "razorpay": "^2.9.8",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cinmax/eslint-config": "workspace:*",
    "@cinmax/tsconfig": "workspace:*",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "typescript": "^5.7.3"
  }
}
