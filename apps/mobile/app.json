{
  "expo": {
    "name": "CINMAX",
    "slug": "cinmax-mobile",
    "version": "1.0.7",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#002754"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow CINMAX to use Face ID for biometric authentication."
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "jsEngine": "hermes",
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "android": {
      "package": "com.cinmax.app",
      "versionCode": 5,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#002754"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61641def-6bfd-45d9-8ab1-fb504ee3e21f"
      }
    },
    "owner": "mownikakanagaraj"
  }
}
